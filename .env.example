# OWNER_PASSWORD: REQUIRED. The real login password for the /owner-dashboard
# CRM. Pick a strong, unique password — this protects all client data,
# leads, and outreach settings. The server refuses to start in production
# without this set.
OWNER_PASSWORD="change-this-to-a-strong-password"

# SESSION_SECRET: Optional. Random string used to sign owner login sessions.
# If left blank, a random one is generated on every server restart, which
# logs everyone out each time the server restarts. Set a fixed value for
# stable sessions across restarts/deploys.
SESSION_SECRET=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# EMAIL_SENDER: Optional verified sender address for CRM outreach emails.
EMAIL_SENDER="mahambitget9807@gmail.com"

# RESEND_API_KEY: Optional API key for Resend email delivery.
RESEND_API_KEY=""

# WHATSAPP_PHONE_NUMBER_ID: Optional Meta WhatsApp Cloud API Phone Number ID.
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_ACCESS_TOKEN: Optional Meta WhatsApp Cloud API Access Token.
WHATSAPP_ACCESS_TOKEN=""

# WHATSAPP_RECIPIENT_NUMBER: YOUR OWN WhatsApp number (country code, digits
# only). This is where "new client" and "email sent" alerts are sent/linked to.
WHATSAPP_RECIPIENT_NUMBER="923247939635"

# DAILY_OUTREACH_LIMIT: How many leads the automatic daily pipeline discovers
# and emails per day. Default is 10. Keep this modest — sending more per day
# to cold, unverified addresses raises the risk of spam complaints and can
# get your sending domain/email flagged.
DAILY_OUTREACH_LIMIT="10"
